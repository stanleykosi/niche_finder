APP_MODE=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nicheintel
REDIS_URL=redis://redis:6379/0

# Workers refuse to dequeue jobs until the shared database reaches Alembic head.
MIGRATION_WAIT_TIMEOUT_SECONDS=300
MIGRATION_POLL_INTERVAL_SECONDS=2

# Browser clients allowed to call FastAPI. Set the exact Vercel production URL
# on Railway; add preview URLs explicitly when preview deployments need API access.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEX=

# Vercel build-time value for apps/web. This is public and must not contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

YOUTUBE_API_KEY=
YOUTUBE_API_DAILY_SEARCH_BUDGET=100
YOUTUBE_API_RESERVED_SEARCH_CALLS=20
YOUTUBE_API_DAILY_UNIT_BUDGET=10000
YOUTUBE_API_RESERVED_UNITS=500
OUTLIER_THRESHOLD=3.0

BROWSER_ENABLED=true
BROWSER_HEADLESS=false
BROWSER_EXECUTABLE_PATH=
# Cleanup-capable roots must be separate children beneath runtime or .runtime.
BROWSER_PROFILE_ROOT=.runtime/browser_profiles
BROWSER_MAX_TABS=4
BROWSER_MAX_QUERIES_PER_RUN=20
BROWSER_MAX_RESULTS_PER_QUERY=30
BROWSER_MAX_CHANNELS_PER_RUN=100

AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=YouTube Niche Intelligence Engine
OPENROUTER_MAX_RETRIES=3
OPENROUTER_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
OLLAMA_MAX_RETRIES=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional reusable-footage preflight. YouTube competitor footage is never counted as reusable.
PEXELS_API_KEY=
PIXABAY_API_KEY=
WIKIMEDIA_USER_AGENT=NicheIntel/1.0 (research tool; contact@example.com)
ASSET_MAX_IDEAS_PER_RUN=30
ASSET_MAX_CONCURRENCY=4
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_DURATION_SECONDS=900
MEDIA_MAX_VIDEOS_PER_RUN=6
MEDIA_WORK_ROOT=.runtime/media
MEDIA_DERIVED_RETENTION_HOURS=24
MEDIA_MAX_STORAGE_GB=5
MEDIA_MIN_FREE_DISK_GB=2
MEDIA_UNKNOWN_DOWNLOAD_RESERVE_MB=150
BROWSER_ARTIFACT_RETENTION_HOURS=24
BROWSER_PROFILE_RETENTION_DAYS=7
YTDLP_EXECUTABLE=yt-dlp
FFMPEG_EXECUTABLE=ffmpeg
EXTERNAL_TRENDS_URL=
EXTERNAL_TRENDS_API_KEY=

CLOSED_TEST_BLOCK_NETWORK=true
FIXTURE_SCENARIO=strong
API_HOST=0.0.0.0
API_PORT=8000
